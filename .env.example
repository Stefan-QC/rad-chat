# Alle instellingen van RAD Chat staan in één bestand: kopieer dit naar .env (npm run setup doet dat voor je).

# Supabase: Project Settings -> API Keys
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Geheim: alleen de server gebruikt dit, nooit in de browser of in git
SUPABASE_SERVICE_ROLE_KEY=

# Alleen voor "npm run dev" (Vite leest alleen variabelen met VITE_)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# GIFs: klipy (sleutel via partner.klipy.com -> API Keys) of giphy
GIF_PROVIDER=klipy
GIPHY_API_KEY=
KLIPY_API_KEY=
GIF_RATING=pg-13

# Server
PORT=3000
TIMEZONE=Europe/Amsterdam
